{
  "id": "s2-vector-recall",
  "kind": "where-is-X-and-what-does-it-store",
  "prompt": "Where is the vector recall search implemented and what does it store on disk?",
  "must": [
    {"pattern": "pixel-recall/src/vector\\.rs", "points": 3, "why": "implementation file"},
    {"pattern": "\\bknn\\b", "points": 2, "why": "the exact brute-force scan entry point"},
    {"pattern": "GPXVECS1|seg-\\d|seg-NNNNNN", "points": 2, "why": "segment file format on disk"},
    {"pattern": "meta\\.json", "points": 1, "why": "vector metadata file"},
    {"pattern": "\\.local/share/pixel/recall|PIXEL_RECALL_DIR", "points": 1, "why": "disk location"},
    {"pattern": "potion|model2vec", "points": 1, "why": "default embedding model"},
    {"pattern": "\\bi8\\b|quantiz", "points": 1, "why": "quantization scheme"},
    {"pattern": "code-vectors|code_search", "points": 2, "why": "distinguishes the separate code-search store"}
  ],
  "never": [
    {"pattern": "(?<!no )(?<!not )(?<!without )(?:(?:uses?|using|with|is) (?:an? )?(?:ANN|HNSW|FAISS)\\b|(?:HNSW|FAISS) (?:index|graph)|approximate nearest neighbor (?:search|index))", "penalty": 2, "why": "the scan is exact brute-force, deliberately no ANN — affirmative claims only, rejections of ANN are correct answers"},
    {"pattern": "vectors (are|is) stored in .*\\.pixel/", "penalty": 1, "why": "transcript vectors live under ~/.local/share/pixel, not .pixel/"}
  ]
}
