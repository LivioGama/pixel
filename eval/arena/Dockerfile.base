# pixel-arena base: identical footing for every arm — codex + python + git.
FROM node:22
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-pip git curl ca-certificates jq \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @openai/codex \
 && git config --global --add safe.directory /repo \
 && git config --global --add safe.directory '*'
# Auth and the repo are mounted at RUNTIME (never baked):
#   -v $HOME/.codex/auth.json:/root/.codex/auth.json:ro
#   -v <repo snapshot>:/repo
WORKDIR /repo
