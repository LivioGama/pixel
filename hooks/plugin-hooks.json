{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/pixel-context.sh\" SessionStart",
            "timeout": 5,
            "statusMessage": "Loading pixel retrieval protocol..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/pixel-context.sh\" SubagentStart",
            "timeout": 5,
            "statusMessage": "Loading pixel retrieval protocol..."
          }
        ]
      }
    ]
  }
}
